{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/bn-visa-checklist.html",
      "destination": "/index.html",
      "permanent": false
    },
    {
      "source": "/en-visa-checklist.html",
      "destination": "/index.html",
      "permanent": false
    }
  ],
  "routes": [
    {
      "src": "/(.*).html",
      "dest": "/$1.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
